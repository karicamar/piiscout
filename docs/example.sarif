{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "PiiScout",
          "version": "1.0.0",
          "informationUri": "https://github.com/karicamar/piiscout",
          "rules": [
            {
              "id": "PII-EMAIL",
              "name": "Emailaddress",
              "shortDescription": {
                "text": "Email address"
              },
              "fullDescription": {
                "text": "Email addresses. Addresses of a role (support@, datenschutz@) and reserved test domains (example.com, .test, .invalid) are reported as information only."
              },
              "help": {
                "text": "Email addresses. Addresses of a role (support@, datenschutz@) and reserved test domains (example.com, .test, .invalid) are reported as information only. Legal reference: Art. 4(1) GDPR."
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "privacy",
                  "gdpr",
                  "Contact"
                ]
              }
            },
            {
              "id": "PII-PHONE",
              "name": "Germanphonenumber",
              "shortDescription": {
                "text": "German phone number"
              },
              "fullDescription": {
                "text": "German phone numbers in national (area code with leading 0) and international (+49, 0049) form. National numbers without a mobile prefix need a context word (Tel., phone, Mobil) to count as likely."
              },
              "help": {
                "text": "German phone numbers in national (area code with leading 0) and international (+49, 0049) form. National numbers without a mobile prefix need a context word (Tel., phone, Mobil) to count as likely. Legal reference: Art. 4(1) GDPR."
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "privacy",
                  "gdpr",
                  "Contact"
                ]
              }
            },
            {
              "id": "PII-DOB",
              "name": "Dateofbirth",
              "shortDescription": {
                "text": "Date of birth"
              },
              "fullDescription": {
                "text": "Dates (31.12.1980, 1980-12-31, 31/12/1980) that a context word or field name marks as a birth date (geb., Geburtsdatum, dob, birth_date). Dates without such context are ignored."
              },
              "help": {
                "text": "Dates (31.12.1980, 1980-12-31, 31/12/1980) that a context word or field name marks as a birth date (geb., Geburtsdatum, dob, birth_date). Dates without such context are ignored. Legal reference: Art. 4(1) GDPR."
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "privacy",
                  "gdpr",
                  "Identity"
                ]
              }
            },
            {
              "id": "PII-IBAN",
              "name": "IBAN",
              "shortDescription": {
                "text": "IBAN"
              },
              "fullDescription": {
                "text": "International bank account numbers, compact or in groups of four. Validated by country length (ISO 13616) and the mod-97 check digits, so random strings do not match."
              },
              "help": {
                "text": "International bank account numbers, compact or in groups of four. Validated by country length (ISO 13616) and the mod-97 check digits, so random strings do not match. Legal reference: Art. 4(1) GDPR."
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "privacy",
                  "gdpr",
                  "Financial"
                ]
              }
            },
            {
              "id": "PII-CARD",
              "name": "Paymentcardnumber",
              "shortDescription": {
                "text": "Payment card number"
              },
              "fullDescription": {
                "text": "Card numbers (PAN) of Visa, Mastercard, American Express, Discover, JCB, Diners and Maestro: Luhn check plus issuer prefix and length. Published test cards are information only."
              },
              "help": {
                "text": "Card numbers (PAN) of Visa, Mastercard, American Express, Discover, JCB, Diners and Maestro: Luhn check plus issuer prefix and length. Published test cards are information only. Legal reference: Art. 4(1) GDPR, PCI DSS 3.3/3.5."
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "privacy",
                  "gdpr",
                  "Financial"
                ]
              }
            },
            {
              "id": "PII-DE-TAXID",
              "name": "GermantaxIDSteuerID",
              "shortDescription": {
                "text": "German tax ID (Steuer-ID)"
              },
              "fullDescription": {
                "text": "The 11-digit Steuerliche Identifikationsnummer: digit distribution rule and ISO 7064 MOD 11,10 check digit. Without a context word (Steuer-ID, IdNr, TIN) it is only a low-confidence hit, because some 11-digit numbers pass by chance."
              },
              "help": {
                "text": "The 11-digit Steuerliche Identifikationsnummer: digit distribution rule and ISO 7064 MOD 11,10 check digit. Without a context word (Steuer-ID, IdNr, TIN) it is only a low-confidence hit, because some 11-digit numbers pass by chance. Legal reference: Art. 87 GDPR, § 139b AO."
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "privacy",
                  "gdpr",
                  "GovernmentId"
                ]
              }
            },
            {
              "id": "PII-DE-IDCARD",
              "name": "GermanIDcardorpassportnumber",
              "shortDescription": {
                "text": "German ID card or passport number"
              },
              "fullDescription": {
                "text": "Document numbers of the German Personalausweis (since 2010) and Reisepass: nine characters from the reduced alphabet plus the ICAO 7-3-1 check digit. Without a context word it is only a low-confidence hit."
              },
              "help": {
                "text": "Document numbers of the German Personalausweis (since 2010) and Reisepass: nine characters from the reduced alphabet plus the ICAO 7-3-1 check digit. Without a context word it is only a low-confidence hit. Legal reference: Art. 87 GDPR, § 20 PAuswG."
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "privacy",
                  "gdpr",
                  "GovernmentId"
                ]
              }
            },
            {
              "id": "PII-DE-SVNR",
              "name": "Germansocialinsurancenumber",
              "shortDescription": {
                "text": "German social insurance number"
              },
              "fullDescription": {
                "text": "The Rentenversicherungsnummer (12 characters: area, birth date, initial of the birth name, serial, check digit). It also reveals the birth date and gender, so it counts as highly sensitive. Validated by date and check digit."
              },
              "help": {
                "text": "The Rentenversicherungsnummer (12 characters: area, birth date, initial of the birth name, serial, check digit). It also reveals the birth date and gender, so it counts as highly sensitive. Validated by date and check digit. Legal reference: Art. 87 GDPR, § 18f SGB IV."
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "privacy",
                  "gdpr",
                  "GovernmentId"
                ]
              }
            },
            {
              "id": "PII-IP",
              "name": "PublicIPaddress",
              "shortDescription": {
                "text": "Public IP address"
              },
              "fullDescription": {
                "text": "Public IPv4 and IPv6 addresses, which are personal data when a person can be identified behind them (CJEU, Breyer). Private, loopback, link-local and carrier-grade NAT ranges are skipped; documentation ranges (192.0.2.0/24, 2001:db8::/32) count as test data."
              },
              "help": {
                "text": "Public IPv4 and IPv6 addresses, which are personal data when a person can be identified behind them (CJEU, Breyer). Private, loopback, link-local and carrier-grade NAT ranges are skipped; documentation ranges (192.0.2.0/24, 2001:db8::/32) count as test data. Legal reference: Art. 4(1) GDPR, CJEU C-582/14 (Breyer)."
              },
              "properties": {
                "security-severity": "3.0",
                "tags": [
                  "privacy",
                  "gdpr",
                  "Network"
                ]
              }
            },
            {
              "id": "PII-HEALTH-ICD",
              "name": "DiagnosiscodeICD10",
              "shortDescription": {
                "text": "Diagnosis code (ICD-10)"
              },
              "fullDescription": {
                "text": "ICD-10 / ICD-10-GM diagnosis codes (a letter, two digits, optional decimals and the certainty marker G/V/Z/A) next to a word like Diagnose, ICD, Befund or Krankschreibung. Health data is a special category under Art. 9 GDPR and may only be processed under strict conditions."
              },
              "help": {
                "text": "ICD-10 / ICD-10-GM diagnosis codes (a letter, two digits, optional decimals and the certainty marker G/V/Z/A) next to a word like Diagnose, ICD, Befund or Krankschreibung. Health data is a special category under Art. 9 GDPR and may only be processed under strict conditions. Legal reference: Art. 9(1) GDPR (health data)."
              },
              "properties": {
                "security-severity": "9.0",
                "tags": [
                  "privacy",
                  "gdpr",
                  "SpecialCategory"
                ]
              }
            },
            {
              "id": "PII-ART9-FIELD",
              "name": "Specialcategoryfield",
              "shortDescription": {
                "text": "Special category field"
              },
              "fullDescription": {
                "text": "A filled CSV column, JSON property or key=value field whose name points to a special category of personal data: religion (incl. Kirchensteuermerkmal), trade union, ethnic origin, health, disability, sexual orientation, genetic or biometric data."
              },
              "help": {
                "text": "A filled CSV column, JSON property or key=value field whose name points to a special category of personal data: religion (incl. Kirchensteuermerkmal), trade union, ethnic origin, health, disability, sexual orientation, genetic or biometric data. Legal reference: Art. 9(1) GDPR."
              },
              "properties": {
                "security-severity": "9.0",
                "tags": [
                  "privacy",
                  "gdpr",
                  "SpecialCategory"
                ]
              }
            },
            {
              "id": "PII-NAME-FIELD",
              "name": "Personnamebyfield",
              "shortDescription": {
                "text": "Person name (by field)"
              },
              "fullDescription": {
                "text": "Values of fields whose name marks a person's name: Vorname, Nachname, Kontoinhaber, debtor, customerName, and the plain column \"Name\" in CSV files. The value must look like a name (letters, no digits or @)."
              },
              "help": {
                "text": "Values of fields whose name marks a person's name: Vorname, Nachname, Kontoinhaber, debtor, customerName, and the plain column \"Name\" in CSV files. The value must look like a name (letters, no digits or @). Legal reference: Art. 4(1) GDPR."
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "privacy",
                  "gdpr",
                  "Identity"
                ]
              }
            }
          ]
        }
      },
