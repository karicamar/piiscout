<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>piiscout</AssemblyName>
    <RootNamespace>PiiScout.Cli</RootNamespace>

    <!-- Installable with: dotnet tool install -g PiiScout -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>piiscout</ToolCommandName>
    <PackageId>PiiScout</PackageId>
    <Version>1.0.0</Version>
    <Authors>Amar Karic</Authors>
    <Description>Finds personal data (GDPR/DSGVO) in files, logs and exports: emails, phone numbers, IBANs, payment cards, German tax IDs, ID card and social insurance numbers, IP addresses and Art. 9 special categories, all validated by check digits. Masked output only, data map, SARIF, redaction.</Description>
    <PackageTags>gdpr;dsgvo;privacy;pii;dlp;security;sarif;devsecops</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/karicamar/piiscout</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PiiScout.Core\PiiScout.Core.csproj" />
  </ItemGroup>

</Project>
